{
  "tests": [
    {
      "name": "OPTIONS запрос",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Получить все рекомендации (публичный)",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Получить по user_id (публичный)",
      "method": "GET",
      "path": "/?user_id=test@test.ru",
      "expectedStatus": 200
    },
    {
      "name": "POST создание без токена возвращает 401",
      "method": "POST",
      "path": "/",
      "body": {"userId": "test@test.com", "propertyData": {"address": "test"}},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "DELETE без токена возвращает 401",
      "method": "DELETE",
      "path": "/?id=999999",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}