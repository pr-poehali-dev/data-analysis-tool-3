{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Запрос без токена — отказ",
      "method": "GET",
      "path": "/?action=stats",
      "expectedStatus": 403,
      "expectedBody": {"error": "Доступ запрещён"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Неверный токен — отказ",
      "method": "GET",
      "path": "/?action=registrations",
      "headers": {"X-Admin-Token": "invalid.token.here"},
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Список пользователей без токена — отказ",
      "method": "GET",
      "path": "/?action=users",
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Блокировка без токена — отказ",
      "method": "POST",
      "path": "/?action=block_user",
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Неизвестный action без токена — отказ",
      "method": "GET",
      "path": "/?action=unknown",
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Список заявок без токена — отказ",
      "method": "GET",
      "path": "/?action=requests",
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Список рекомендаций без токена — отказ",
      "method": "GET",
      "path": "/?action=recommendations",
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Изменение статуса заявки без токена — отказ",
      "method": "POST",
      "path": "/?action=update_request_status",
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Удаление рекомендации без токена — отказ",
      "method": "POST",
      "path": "/?action=delete_recommendation",
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Список сделок без токена — отказ",
      "method": "GET",
      "path": "/?action=escrow",
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Детали сделки без токена — отказ",
      "method": "GET",
      "path": "/?action=escrow_detail&id=1",
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Смена статуса сделки без токена — отказ",
      "method": "POST",
      "path": "/?action=update_escrow_status",
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    }
  ]
}