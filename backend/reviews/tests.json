{
  "tests": [
    {
      "name": "OPTIONS returns CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET отзывы по email (публичный)",
      "method": "GET",
      "path": "/?reviewee_email=recommender@test.com",
      "expectedStatus": 200
    },
    {
      "name": "POST создание отзыва без токена возвращает 401",
      "method": "POST",
      "path": "/",
      "body": {
        "chat_id": "1",
        "recommendation_id": "1",
        "reviewer_email": "test@test.com",
        "reviewer_name": "Test",
        "reviewee_email": "other@test.com",
        "reviewee_name": "Other",
        "rating": 5
      },
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET без параметров возвращает 400",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
