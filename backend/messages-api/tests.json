{
  "tests": [
    {
      "name": "OPTIONS returns CORS headers",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET chats without token returns 401",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET messages without token returns 401",
      "method": "GET",
      "path": "/?action=messages&chat_id=1",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET unread count without token returns 401",
      "method": "GET",
      "path": "/?action=unread_count",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET chat_by_recommendation without token returns 401",
      "method": "GET",
      "path": "/?action=chat_by_recommendation&recommendation_id=1",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST create chat without token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"tenantEmail": "a@b.com", "recommenderEmail": "c@d.com"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST send message without token returns 401",
      "method": "POST",
      "path": "/?action=send",
      "body": {"chatId": "1", "senderId": "test@test.com", "text": "hello"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST delete_chat without token returns 401",
      "method": "POST",
      "path": "/?action=delete_chat",
      "body": {"chatId": "1"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
